{
  "name": "ctchickens",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "emulate:seed": "node .\\seed-emualtor.js",
    "emulate": "firebase emulators:start --project demo-ct-chickens",
    "emulate:persist": "firebase emulators:start --project demo-ct-chickens --import=./seed-data --export-on-exit",
    "emulate:export": "firebase emulators:export ./seed-data --project demo-ct-chickens"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "bootstrap-vue-next": "^0.42.0",
    "firebase": "^12.10.0",
    "vue": "^3.5.24",
    "vue-router": "^4.6.4",
    "vuex": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "jsdom": "^28.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.1.4",
    "firebase-tools": "^13.31.1"
  }
}



