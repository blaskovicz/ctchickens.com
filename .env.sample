# --- FACEBOOK CONFIGURATION ---
# Your Facebook App ID for authentication
FACEBOOK_APP_ID=123456789012345
# Your Facebook App Secret (Keep this private!)
FACEBOOK_APP_SECRET_ID=your_facebook_app_secret_here

# --- FIREBASE CONFIGURATION ---
# Found in Firebase Console > Project Settings > General > Your Apps
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- APP SETTINGS ---
# Set to 'true' to use the local Firebase Emulators
VITE_APP_USE_EMULATOR=false

# --- BUILD SETTINGS ---
# Optional: The full 40-character git commit hash. 
# Automatically injected by CI/CD (VITE_GIT_COMMIT_HASH: ${{ github.sha }})
VITE_GIT_COMMIT_HASH=HEAD