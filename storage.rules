rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Publicly readable images
    match /{allPaths=**} {
      allow read: if true;
    }

    // Protect directory member assets (owner or admin only)
    match /directory_members/{memberId}/{allPaths=**} {
      allow write: if request.auth != null && (request.auth.uid == memberId || request.auth.token.admin == true);
    }

    // Classifieds images
    match /classifieds/{userId}/{fileName} {
      allow create, update: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Default: Only admins can write to other locations
    match /{allPaths=**} {
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
