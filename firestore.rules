// Rules Version: 2026-04-21-02
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() { 
      return request.auth != null; 
    }

    function isUserAdmin(uid) {
      return uid != null && 
      exists(/databases/$(database)/documents/users/$(uid)) && 
      get(/databases/$(database)/documents/users/$(uid)).data.get('isAdmin', false) == true;
    }

    function isBlocked(uid) {
      return uid != null && 
      exists(/databases/$(database)/documents/users/$(uid)) && 
      get(/databases/$(database)/documents/users/$(uid)).data.get('blockedFromChat', false) == true;
    }

    function isParticipant(uid, tData) {
      return uid != null && tData != null && (
      // 1. User is the original sender
      tData.get('userUid', '') == uid || 
      // 2. User is an Admin and this is a support thread
      (tData.get('type', 'inquiry') == 'support' && isUserAdmin(uid)) ||
      // 3. User is the CURRENT owner of the breederSlug
      (tData.get('breederSlug', '') != '' && 
      exists(/databases/$(database)/documents/directory_members/$(tData.breederSlug)) &&
      get(/databases/$(database)/documents/directory_members/$(tData.breederSlug)).data.account.get('ownerUid', '') == uid) ||
      // 4. Fallback for legacy threads or explicit participation
      uid in tData.get('participants', [])
      );
    }

    function userLocalEmail(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('localEmail', '');
    }

    function farmContactEmail(slug) {
      return get(/databases/$(database)/documents/directory_members/$(slug)).data.profile.contactEmail;
    }

    function isValidDraftSchema(data) {
      return data.keys().hasAll(['profile', 'offerings', 'media', 'draft_owner_uid', 'updatedAt']) &&
      data.keys().hasOnly(['profile', 'offerings', 'media', 'draft_owner_uid', 'updatedAt']);
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isUserAdmin(request.auth.uid));
      // Admins can write anything (e.g. set isAdmin, blockedFromChat)
      allow write: if isSignedIn() && isUserAdmin(request.auth.uid);
      // Users can create their own doc on first login — safe fields only, no isAdmin/blockedFromChat
    // email must match the auth token — can't be spoofed to an arbitrary address
      allow create: if isSignedIn() && request.auth.uid == userId &&
      request.resource.data.keys().hasOnly(['displayName', 'email', 'photoURL', 'lastLogin']) &&
      request.resource.data.get('email', request.auth.token.email) == request.auth.token.email;
      // Users can only touch their own profile fields — never isAdmin or blockedFromChat
    // If email is being changed it must still match the auth token (no spoofing)
      allow update: if isSignedIn() && request.auth.uid == userId &&
      request.resource.data.diff(resource.data).affectedKeys()
      .hasOnly(['displayName', 'email', 'photoURL', 'lastLogin']) &&
      request.resource.data.get('email', request.auth.token.email) == request.auth.token.email;
    }

    match /directory_members/{memberId} {
      allow read: if resource == null || 
      resource.data.account.status == "published" || 
      (isSignedIn() && isUserAdmin(request.auth.uid));

      // Allow write by admins, but enforce schema to prevent accidental pollution
      allow write: if isSignedIn() && isUserAdmin(request.auth.uid) &&
      request.resource.data.keys().hasOnly(['profile', 'offerings', 'media', 'account']);
    }

    match /draft_profile_history/{historyId} {
      allow read, create, delete: if isSignedIn() && isUserAdmin(request.auth.uid);
      allow update: if false;
    }

    match /draft_profiles/{draftId} {
      allow read: if isSignedIn() && (
      isUserAdmin(request.auth.uid) || 
      resource == null || 
      resource.data.get('draft_owner_uid', '') == request.auth.uid || 
      resource.data.get(['account', 'ownerUid'], '') == request.auth.uid
      );

      allow create: if isSignedIn() && (
      isUserAdmin(request.auth.uid) || 
      (
      isValidDraftSchema(request.resource.data) &&
      request.resource.data.get('draft_owner_uid', '') == request.auth.uid &&
      // New signup (!exists) OR Owner of the live listing (exists)
      (
      !exists(/databases/$(database)/documents/directory_members/$(draftId)) ||
      get(/databases/$(database)/documents/directory_members/$(draftId)).data.account.ownerUid == request.auth.uid
      )
      )
      );

      // update/delete must check the EXISTING owner (resource.data), not the incoming payload
      // Non-admins must also pin draft_owner_uid to their own UID — prevents ownership transfer attacks
      allow update: if isSignedIn() && (
      isUserAdmin(request.auth.uid) ||
      (
      (resource.data.draft_owner_uid == request.auth.uid ||
      resource.data.get(['account', 'ownerUid'], '') == request.auth.uid) &&
      request.resource.data.draft_owner_uid == request.auth.uid
      )
      ) && isValidDraftSchema(request.resource.data);

      allow delete: if isSignedIn() && (
      isUserAdmin(request.auth.uid) || 
      resource.data.draft_owner_uid == request.auth.uid ||
      resource.data.get(['account', 'ownerUid'], '') == request.auth.uid
      );
    }

    match /claim_requests/{requestId} {
      allow read: if isSignedIn() && (resource == null || isUserAdmin(request.auth.uid) || resource.data.requesterUid == request.auth.uid);

      allow create: if isSignedIn() 
        && !exists(/databases/$(database)/documents/claim_requests/$(requestId))
        && exists(/databases/$(database)/documents/directory_members/$(requestId))
        && get(/databases/$(database)/documents/directory_members/$(requestId)).data.account.get('ownerUid', null) == null
        && request.resource.data.requesterUid == request.auth.uid
      // Anti-tampering: the email written to the doc must be one of the user's own verified
      // emails. The two paths are mutually exclusive — if a localEmail is set, it must be
      // used. email_verified only guards the OAuth path; localEmail has its own HMAC
      // verification flow, so its presence in the users doc is proof enough.
        && (
      (userLocalEmail(request.auth.uid) == ''
        && request.auth.token.email_verified == true
        && request.resource.data.requesterEmail.lower() == request.auth.token.email.lower())
        || (userLocalEmail(request.auth.uid) != ''
        && request.resource.data.requesterEmail.lower() == userLocalEmail(request.auth.uid).lower())
      )
        && request.resource.data.status == 'pending'
        && request.resource.data.businessSlug == requestId
        && request.resource.data.createdAt == request.time
      // Authorization: requesterEmail is already proven to be the user's own verified email
    // above, so we just need it to match the farm's contact email.
        && farmContactEmail(requestId).lower() == request.resource.data.requesterEmail.lower()
        && request.resource.data.keys().hasOnly(['requesterUid', 'requesterEmail', 'requesterName', 'requesterPhotoURL', 'status', 'businessName', 'businessSlug', 'createdAt']);

      // Only admins can change a claim's status (approve/reject workflow)
      allow update: if isSignedIn() && isUserAdmin(request.auth.uid);

      // Users can withdraw their own claim; check EXISTING owner, not incoming payload
      allow delete: if isSignedIn() && (isUserAdmin(request.auth.uid) || (resource != null && resource.data.requesterUid == request.auth.uid));
    }

    match /inquiry_threads/{threadId} {
      allow list: if isSignedIn() && (
      isUserAdmin(request.auth.uid) ||
      request.auth.uid in resource.data.get('participants', []) ||
      resource.data.get('userUid', '') == request.auth.uid
      );
      allow read: if isSignedIn() && (isUserAdmin(request.auth.uid) || resource == null || isParticipant(request.auth.uid, resource.data));

      allow create: if isSignedIn() && !isBlocked(request.auth.uid) &&
      request.resource.data.userUid == request.auth.uid &&
      request.auth.uid in request.resource.data.get('participants', []) &&
      (
      (request.resource.data.get('type', 'inquiry') == 'support' && 
      threadId == 'support_' + request.auth.uid && 
      request.resource.data.breederSlug == 'support') ||
      (request.resource.data.get('type', 'inquiry') == 'inquiry' && 
      threadId == request.auth.uid + '_' + request.resource.data.breederSlug &&
      request.resource.data.breederSlug != 'support' &&
      exists(/databases/$(database)/documents/directory_members/$(request.resource.data.breederSlug)))
      );

      allow update: if isSignedIn() && !isBlocked(request.auth.uid) && (
      isUserAdmin(request.auth.uid) || 
      (isParticipant(request.auth.uid, resource.data) && 
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt', 'unreadCount']))
      );

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
        isUserAdmin(request.auth.uid) || 
        (exists(/databases/$(database)/documents/inquiry_threads/$(threadId)) && 
        isParticipant(request.auth.uid, get(/databases/$(database)/documents/inquiry_threads/$(threadId)).data))
        );
        allow create: if isSignedIn() && !isBlocked(request.auth.uid) && 
        request.resource.data.senderUid == request.auth.uid &&
        (isUserAdmin(request.auth.uid) || isParticipant(request.auth.uid, getAfter(/databases/$(database)/documents/inquiry_threads/$(threadId)).data));
        allow update: if isSignedIn() && (
        // Admin moderation
        isUserAdmin(request.auth.uid) ||
        // Participant: flag a message — can only set adminReviewStatus to 'pending', never clear/override it
        (isParticipant(request.auth.uid, get(/databases/$(database)/documents/inquiry_threads/$(threadId)).data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['flaggedByUid', 'adminReviewStatus']) &&
        request.resource.data.get('adminReviewStatus', 'pending') == 'pending') ||
        // Participant: mark a received message as read
        (isParticipant(request.auth.uid, get(/databases/$(database)/documents/inquiry_threads/$(threadId)).data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
        resource.data.senderUid != request.auth.uid)
        );
      }
    }

    match /draft_classifieds/{docId} {
      allow read: if isSignedIn() && (
      resource == null ||
      isUserAdmin(request.auth.uid) ||
      resource.data.owner_uid == request.auth.uid
      );
      allow create: if isSignedIn() &&
      request.resource.data.owner_uid == request.auth.uid &&
      request.resource.data.status == 'pending' &&
      request.resource.data.keys().hasOnly(['owner_uid', 'display_name', 'location', 'title', 'description', 'category', 'created_at', 'status']);
      allow delete: if isSignedIn() && (
      resource == null ||
      isUserAdmin(request.auth.uid) ||
      resource.data.owner_uid == request.auth.uid
      );
      allow update: if false;
    }


    match /classifieds/{docId} {
      allow get: if
      resource == null ||
      resource.data.status == 'active' ||
      (isSignedIn() && (
      isUserAdmin(request.auth.uid) ||
      resource.data.owner_uid == request.auth.uid
      ));
      allow list: if
      resource == null ||
      resource.data.status == 'active' ||
      (isSignedIn() && (
      isUserAdmin(request.auth.uid) ||
      resource.data.owner_uid == request.auth.uid
      ));
      allow write: if isSignedIn() && isUserAdmin(request.auth.uid);

      match /actions/{actionId} {
        allow create: if isSignedIn() &&
        request.resource.data.owner_uid == request.auth.uid &&
        request.resource.data.action in ['renew', 'discard'] &&
        request.resource.data.keys().hasOnly(['action', 'created_at', 'owner_uid']) &&
        (isUserAdmin(request.auth.uid) ||
        get(/databases/$(database)/documents/classifieds/$(docId)).data.owner_uid == request.auth.uid);
        allow read: if false;
      }
    }

    match /draft_classified_history/{historyId} {
      // Admins can create and update — batch.set() evaluates as 'update' when the doc already
      // exists (e.g. a listing that was previously rejected and is being re-submitted).
      allow read, create, update, delete: if isSignedIn() && isUserAdmin(request.auth.uid);
    }

    // Required for admin collectionGroup query of flagged messages across all threads
    match /{path=**}/messages/{messageId} {
      allow read, list: if isSignedIn() && isUserAdmin(request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
