rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS ---

    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    function isOwner(uid) { 
      return isSignedIn() && request.auth.uid == uid; 
    }
    
    function hasOnlyFields(data, fields) { 
      return data.keys().hasOnly(fields); 
    }

    // Type Validators
    function isString(val) { return val is string; }
    function isList(val) { return val is list; }
    function isValidEmail(email) { return email.matches('^.+@.+\\..+$'); }
    function isValidUrl(url) { return url == null || url == "" || url.matches('^https?://.+$'); }

    // --- SCHEMA VALIDATORS ---

    function isValidProfile() {
      let profile = request.resource.data.profile;
      return isString(profile.town) && isValidEmail(profile.contactEmail) && isValidUrl(profile.website);
    }

    function isValidOfferings() {
      let offerings = request.resource.data.offerings;
      return isString(offerings.description) && isList(offerings.searchTags);
    }

    function isValidMedia() {
      let media = request.resource.data.media;
      return isValidUrl(media.logoUrl) && isList(media.galleryUrls);
    }

    function isValidAccount() {
      let account = request.resource.data.account;
      return isString(account.ownerUid) && account.status in ['published', 'draft'] && account.updatedAt is timestamp;
    }

    function isValidListing() {
      return hasOnlyFields(request.resource.data, ['profile', 'offerings', 'media', 'account'])
             && isValidProfile() && isValidOfferings() && isValidMedia() && isValidAccount();
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) 
                   && hasOnlyFields(request.resource.data, ['displayName', 'email', 'photoURL', 'lastLogin', 'isAdmin'])
                   && (request.resource.data.get('isAdmin', false) == false || isAdmin());
    }

    match /directory_members/{memberId} {
      allow read: if (resource == null) || (resource.data.get(['account', 'status'], 'draft') == "published") || isAdmin();
      allow write: if isAdmin();
    }

    match /draft_profiles/{draftId} {
      // allow read if document doesn't exist (so getDoc returns exists: false)
      // or if it exists and the user is the owner or an admin
      allow read: if (resource == null) || (isSignedIn() && (resource.data.account.ownerUid == request.auth.uid || isAdmin()));
      
      // Delete requires it to exist and be the owner or admin
      allow delete: if isAdmin() || (isSignedIn() && resource != null && resource.data.account.ownerUid == request.auth.uid);
      
      // Create/Update uses request.resource which is never null during a write
      allow create, update: if isAdmin() || (isSignedIn() && request.resource.data.account.ownerUid == request.auth.uid && isValidListing());
    }

    match /claim_requests/{requestId} {
      allow create: if isSignedIn() 
                   && request.resource.data.requesterUid == request.auth.uid
                   && !exists(/databases/$(database)/documents/claim_requests/$(requestId));
      
      allow read: if (resource == null) || (isSignedIn() && (resource.data.get('requesterUid', '') == request.auth.uid || isAdmin()));
      allow delete: if isAdmin() || (isSignedIn() && resource != null && resource.data.get('requesterUid', '') == request.auth.uid);
      allow update: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
